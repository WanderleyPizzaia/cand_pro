# Copie para .env.local e preencha. NÃO commitar o .env.local.

# OBRIGATÓRIO em produção: segredo que assina o cookie de sessão.
# Gere um valor forte, ex.: openssl rand -base64 48
# Sem isto, o sistema usa um fallback público (permite forjar login de ADMIN).
AUTH_SECRET=

# Postgres (Supabase). No Vercel, configure como Environment Variables.
PGHOST=
PGPORT=
PGUSER=postgres
PGPASSWORD=
PGDATABASE=postgres
# PGSSL=true   # descomente se o Postgres exigir SSL

# Primeiro acesso: num banco SEM nenhum usuário, o sistema cria um admin com
# estes dados. Sem eles, nenhum usuário é criado (não existe senha padrão).
# Depois do primeiro login, troque a senha em "Alterar senha" e pode apagar daqui.
ADMIN_EMAIL=
ADMIN_SENHA=

# Supabase REST/Auth (opcional — usado se for acessar via API REST)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Integrações (também configuráveis pela tela de Configurações)
EVOLUTION_URL=
EVOLUTION_APIKEY=
ANTHROPIC_API_KEY=

# Segredos dos webhooks. SEM eles, o webhook correspondente RECUSA as chamadas.
# WEBHOOK_TOKEN (Evolution) é gerado sozinho pelo sistema; só defina aqui se
# quiser fixar um valor. Gere valores com: openssl rand -hex 24
WEBHOOK_TOKEN=
# App Secret do app da Meta (valida a assinatura do webhook da API oficial).
META_APP_SECRET=
# Token compartilhado com o n8n (disparo em massa e agente de IA).
N8N_TOKEN=
# Token exigido no webhook de confirmação de PIX do BTG (?token=...).
BTG_WEBHOOK_TOKEN=
